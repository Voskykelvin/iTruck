{
  "name": "itruck",
  "version": "1.0.0",
  "description": "iTruck Africa premium logistics platform",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "app:dev": "npm --prefix workspace run dev",
    "app:build": "npm --prefix workspace run build",
    "app:preview": "npm --prefix workspace run preview",
    "build": "npm --prefix workspace run build",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend test",
    "test:frontend": "npm --prefix workspace test",
    "test:e2e": "npm --prefix workspace run test:e2e",
    "test:coverage": "npm --prefix backend run test:coverage",
    "live:check": "npm --prefix backend run live:check",
    "lint": "eslint \"backend/**/*.js\" \"workspace/src/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"backend/**/*.js\" \"workspace/src/**/*.{js,jsx}\" \"frontend/js/**/*.js\"",
    "format": "prettier --write \"backend/**/*.js\" \"workspace/src/**/*.{js,jsx}\" \"frontend/js/**/*.js\"",
    "ci:check": "npm run lint && npm run format:check && npm test && npm run test:frontend && npm run app:build",
    "docker:build": "docker build -t itruck .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f app"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.4"
  }
}
