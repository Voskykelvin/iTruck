# Production Environment Variables for Render.com
# Copy this file to .env.render and fill in the actual values
# NEVER commit .env.render to git

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=AppName
JWT_SECRET=your-secure-32-character-jwt-secret-here
DELIVERY_OTP_PEPPER=your-separate-secure-delivery-otp-secret
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
GOOGLE_MAPS_API_KEY=your_google_maps_key
FRONTEND_URL=https://itruck.onrender.com
ALLOWED_ORIGINS=https://itruck.onrender.com
MPESA_CALLBACK_URL=https://itruck.onrender.com/api/payments/webhooks/mpesa/stk
MPESA_WEBHOOK_SECRET=replace-with-a-random-callback-secret
EMAIL_FROM=iTruck <no-reply@your-domain.example>
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_URL=
