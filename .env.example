# iTruck live configuration
NODE_ENV=production
LIVE_MODE=true
DEMO_MODE=false

# Required in live mode
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/itruck
JWT_SECRET=replace-with-at-least-32-random-characters
DELIVERY_OTP_PEPPER=replace-with-a-separate-32-character-random-secret
# Use simple for photo-only delivery completion; set strict in full production to require OTP, signature, and GPS.
DELIVERY_PROOF_MODE=simple
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_EXPIRES=7d
ACCESS_COOKIE_NAME=itruck_access
REFRESH_COOKIE_NAME=itruck_refresh
CSRF_COOKIE_NAME=itruck_csrf
AUTH_COOKIE_SAMESITE=none
FRONTEND_URL=https://your-domain.example
APP_URL=https://your-domain.example
ALLOWED_ORIGINS=https://your-domain.example
LOG_LEVEL=info
METRICS_AUTH_TOKEN=replace-with-a-separate-random-monitoring-token
OPERATIONS_ALERT_WEBHOOK_URL=
OPERATIONS_ALERT_COOLDOWN_MS=900000

# Required in live mode for uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=
MAPS_TIMEOUT_MS=15000
ROUTE_DEVIATION_ALERT_COOLDOWN_MINUTES=30

# Optional integrations
REDIS_URL=
DISABLE_REDIS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_RATE=0.025
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.example/api/payments/webhooks/mpesa/stk
MPESA_WEBHOOK_SECRET=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_CALLBACK_URL=https://your-domain.example/api/payments/webhooks/mtn/request-to-pay
MTN_MOMO_WEBHOOK_SECRET=
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_MOMO_DISBURSEMENT_API_USER=
MTN_MOMO_DISBURSEMENT_API_KEY=
MTN_MOMO_DISBURSEMENT_CALLBACK_URL=https://your-domain.example/api/payments/webhooks/mtn/disbursement
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_RESULT_URL=https://your-domain.example/api/payments/webhooks/mpesa/b2c/result
MPESA_B2C_TIMEOUT_URL=https://your-domain.example/api/payments/webhooks/mpesa/b2c/timeout
MPESA_REVERSAL_INITIATOR_NAME=
MPESA_REVERSAL_SECURITY_CREDENTIAL=
MPESA_REVERSAL_RESULT_URL=https://your-domain.example/api/payments/webhooks/mpesa/reversal/result
MPESA_REVERSAL_TIMEOUT_URL=https://your-domain.example/api/payments/webhooks/mpesa/reversal/timeout
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
DELIVERY_OTP_TTL_MINUTES=10
DELIVERY_OTP_COOLDOWN_SECONDS=60
EMAIL_PROVIDER=
EMAIL_FROM=iTruck <no-reply@your-domain.example>
EMAIL_PROVIDER_MODULE=
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operations@your-domain.example
NOTIFICATION_RECEIPT_SECRET=

# Notification delivery worker and operational reminders
NOTIFICATION_WORKER_INTERVAL_MS=15000
NOTIFICATION_WORKER_BATCH_SIZE=20
OPERATIONS_SCAN_INTERVAL_MS=900000
TRACKING_STALE_MINUTES=45
EMAIL_TIMEOUT_MS=15000
SMS_TIMEOUT_MS=15000
CASE_SLA_FIRST_RESPONSE_MINUTES_LOW=480
CASE_SLA_FIRST_RESPONSE_MINUTES_NORMAL=240
CASE_SLA_FIRST_RESPONSE_MINUTES_HIGH=60
CASE_SLA_FIRST_RESPONSE_MINUTES_URGENT=30
CASE_SLA_RESOLUTION_MINUTES_LOW=7200
CASE_SLA_RESOLUTION_MINUTES_NORMAL=4320
CASE_SLA_RESOLUTION_MINUTES_HIGH=1440
CASE_SLA_RESOLUTION_MINUTES_URGENT=480
CASE_REOPEN_DAYS=14
CASE_AUTO_CLOSE_DAYS=7
ABANDONED_BOOKING_HOURS=72
DISABLE_BACKGROUND_JOBS=false
BACKUP_DIR=
